[Unit]
Description=Immich photo and video server
Documentation=https://docs.immich.app/
Wants=network-online.target
After=network-online.target postgresql.service valkey.service

[Service]
Type=simple
User=immich
Group=immich
Environment=NODE_ENV=production
EnvironmentFile=/etc/immich/immich.conf
WorkingDirectory=/usr/libexec/immich/server
ExecStart=/usr/bin/node /usr/libexec/immich/server/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0027
StateDirectory=immich
StateDirectoryMode=0750
CacheDirectory=immich
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/immich

[Install]
WantedBy=multi-user.target
